# Vorlage für die .env
# einfach "npm run setup" ausführen, dann wird die .env mit Schlüsseln erstellt
# die .env kommt nicht ins Git!

# Allgemein
PORT=3000
DB_PATH=./data/database.sqlite
# Adresse der Seite (für den Link in der Mail)
PUBLIC_URL=http://localhost:4200
# NODE_ENV=production   # wenn die Seite online ist

# Schlüssel (macht npm run setup)
# für die Login-Tokens, mind. 32 Zeichen
JWT_SECRET=
# zum Verschlüsseln der Nachrichten (32 Byte, Base64)
# nicht verlieren oder ändern, sonst kann man die Nachrichten nicht mehr lesen!
MESSAGE_ENCRYPTION_KEY=

# Login
SESSION_HOURS=2
# COOKIE_SECURE=true    # online true, lokal false

# Admin
# Benutzername für den ersten Start, das Passwort steht dann einmal in der Konsole
ADMIN_USERNAME=admin

# Nachrichten nach X Tagen löschen (0 = nie)
MESSAGE_RETENTION_DAYS=180

# HTTPS (optional)
# Zertifikat und Schlüssel, oder https über nginx o.ä. machen
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=

# Mail
# wenn SMTP_HOST leer ist wird ein Ethereal Testkonto benutzt (Link in der Konsole)
SMTP_HOST=
SMTP_PORT=587
# true bei Port 465, sonst false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Website <no-reply@example.com>"
MAIL_TO=
# Nachrichtentext mit in die Mail schreiben? (Mail ist nicht verschlüsselt)
MAIL_INCLUDE_CONTENT=false
